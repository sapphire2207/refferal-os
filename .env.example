# Database - Update with your PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Redis - Update with your Redis connection details
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-super-secure-jwt-secret-change-in-production"
JWT_EXPIRATION="24h"
JWT_REFRESH_EXPIRATION="7d"

# API
API_PORT="3001"
API_URL="http://localhost:3001"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Python Document Processor
DOCUMENT_PROCESSOR_URL="http://localhost:8000"
DOCUMENT_PROCESSOR_PORT="8000"

# Gemini AI
GEMINI_API_KEY="your-gemini-api-key-here"

# File Upload
MAX_FILE_SIZE_MB="50"
UPLOAD_DIR="./uploads"

# Security
BCRYPT_ROUNDS="12"
RATE_LIMIT_TTL="60"
RATE_LIMIT_MAX="100"

# Session
SESSION_TIMEOUT_MINUTES="30"
MFA_ENABLED="false"

# Email (Placeholder for future)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Environment
NODE_ENV="development"
